{
  "name": "code-copilot-jeopardy",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "packs:sync": "node scripts/generate-pack-registry.mjs",
    "packs:check": "node scripts/generate-pack-registry.mjs --check",
    "questions:check": "npm run packs:check && vitest run tests/packs.test.ts",
    "predev": "npm run packs:sync",
    "dev": "tsx server/index.ts --dev",
    "pretypecheck": "npm run packs:sync",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "pretest": "npm run packs:sync",
    "test": "vitest run tests",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:webkit": "playwright test --project=webkit",
    "lint": "eslint .",
    "prebuild": "npm run packs:sync",
    "build": "npm run typecheck && npm run typecheck:server && vite build",
    "start": "npm run build && npm run serve",
    "serve": "tsx server/index.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "socket.io": "4.8.3",
    "socket.io-client": "4.8.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.3",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "tsx": "4.23.15",
    "typescript": "5.9.2",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "overrides": {
    "rolldown": "1.2.8"
  }
}

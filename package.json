{
  "name": "code-copilot-jeopardy",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "packs:sync": "node scripts/generate-pack-registry.mjs",
    "music:sync": "node scripts/sync-background-music.mjs",
    "predev": "npm run packs:sync && npm run music:sync",
    "dev": "vite --host 0.0.0.0",
    "pretypecheck": "npm run packs:sync",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run packs:sync",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "prebuild": "npm run packs:sync && npm run music:sync",
    "build": "npm run typecheck && vite build",
    "start": "vite preview --host 0.0.0.0 --port 3000"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "peerjs": "1.5.5",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.3",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "overrides": {
    "rolldown": "1.2.8"
  }
}
